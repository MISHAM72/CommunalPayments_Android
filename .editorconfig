root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 500

[*.xml]
indent_size = 4
indent_style = space
max_line_length = 500

[*.md]
max_line_length = 500
trim_trailing_whitespace = false # чтобы не портить markdown-разметку